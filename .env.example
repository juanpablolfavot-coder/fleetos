# ══════════════════════════════════════════
#  FleetOS — Variables de entorno
#  NUNCA subir este archivo a GitHub
#  Copiar como .env y completar los valores
# ══════════════════════════════════════════

# Base de datos PostgreSQL (Render PostgreSQL o Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/fleetos

# JWT Secret — generá uno aleatorio con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_MUY_LARGO_64_CHARS_MINIMO
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=production

# Seguridad
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# CORS — URL(s) del frontend (tu dominio de Render). Acepta varias separadas por coma.
# Si se completa, CORS se restringe a estos orígenes. Si se deja vacío, se mantiene
# el comportamiento permisivo previo (no recomendado en producción).
FRONTEND_URL=https://fleetos.onrender.com

# GPS Powerfleet (Rusegur) — credenciales del proveedor de monitoreo.
# OBLIGATORIAS para que funcione el sync GPS. Sin ellas, el GPS queda desactivado
# (el resto del sistema funciona normal). NUNCA hardcodearlas en el código.
GPS_USER=
GPS_PASSWORD=
# Dejar en false (o sin definir) para validar el certificado TLS del proveedor.
# Poner true SOLO si el proveedor usa un certificado que no valida y se corta el sync.
GPS_TLS_INSECURE=false
# Cada cuántos minutos se consulta a Powerfleet. Default 2. Menos minutos = alertas
# más a tiempo pero más consultas al proveedor.
# GPS_SYNC_MINUTES=2

# ── Webhook de Powerfleet: la alerta de velocidad, en el momento ──
# Sin esto el exceso se detecta en el sondeo, o sea hasta GPS_SYNC_MINUTES tarde.
# Con esto Powerfleet avisa apenas lo detecta. El sondeo se mantiene igual (es el
# que cierra el evento); el webhook solo adelanta la notificación.
#
# GPS_WEBHOOK_SECRET es la ÚNICA puerta del endpoint (lo llama una máquina del
# proveedor, sin sesión): va dentro de la URL que se registra. Si falta, el
# webhook queda desactivado y no cambia nada de lo que ya funciona.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GPS_WEBHOOK_SECRET=
# La URL pública se arma con FRONTEND_URL. Definir GPS_WEBHOOK_URL solo si el
# dominio real es otro (o si FRONTEND_URL tiene varios separados por coma).
# GPS_WEBHOOK_URL=https://fleetos-bn5v.onrender.com
# Días de vida que se le piden a la suscripción (se renueva sola una semana antes).
# GPS_WEBHOOK_DIAS=365
#
# Una vez seteadas, dar de alta la suscripción UNA vez desde el Shell de Render:
#   node scripts/webhook-powerfleet.js alta

# ── Notificaciones push a los dueños (Web Push / VAPID) ──
# Habilitan las alertas de exceso de velocidad y el resumen periódico de flota.
# Si faltan, TODO el push queda desactivado en silencio: los eventos se siguen
# registrando y se ven en el panel auditor, pero no sale ninguna notificación.
# El par se genera UNA vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcionales:
# VAPID_SUBJECT=mailto:info@expresobiletta.com
# SPEED_ALERT_KMH=80        # umbral de exceso de velocidad (default 80)

# ── Aviso de documentación por vencer (VTV, seguro, licencias, RUTA…) ──
# El dato ya se cargaba en la pantalla de Documentación; esto hace que ALGUIEN
# AVISE. Va por push a dueños, gerencia y jefe de mantenimiento. Si faltan las
# claves VAPID de arriba, el push queda desactivado y esto no manda nada.
#
# NO repite el mismo aviso todos los días: sale cuando CAMBIA algo (entró un
# documento nuevo a la ventana o uno pasó a vencido) y, si no cambia nada, como
# mucho un recordatorio cada VENCIMIENTOS_RECORDAR_DIAS.
# VENCIMIENTOS_OFF=1              # desactiva el aviso por completo
# VENCIMIENTOS_DIAS=30            # ventana: cuántos días para adelante mirar
# VENCIMIENTOS_DIAS_CRITICO=7     # a partir de acá se marca como urgente
# VENCIMIENTOS_HORA=8             # inicio de la ventana horaria (hora argentina)
# VENCIMIENTOS_HORA_HASTA=22      # fin de la ventana: ni a las 3 AM ni a las 23
# VENCIMIENTOS_RECORDAR_DIAS=7    # recordatorio si no cambió nada
# VENCIMIENTOS_EMAIL_TO=          # además del push, mandar el detalle por mail (usa SMTP_*)
#
# A quiénes avisar. Por defecto SOLO los roles que además pueden ABRIR la
# pantalla de Documentación: una notificación que al tocarla lleva a "home" es
# peor que no mandarla.
# jefe_mantenimiento es el dueño natural del tema pero HOY no tiene el módulo
# 'documents' (public/js/roles.js). Para sumarlo hay que darle ese módulo
# primero y después agregarlo acá.
# VENCIMIENTOS_ROLES=dueno,gerencia

# ── Mantenimiento preventivo (push) ──
# Avisa qué toca ANTES de que se rompa, mirando los contadores que ya se
# actualizan solos: km_current (GPS + cargas de combustible) y el horómetro.
# MODO AVISO: no genera órdenes de trabajo, solo avisa. Abrir la OT sigue siendo
# decisión de una persona.
# MANTENIMIENTO_OFF=1                          # desactiva el aviso
# MANTENIMIENTO_HORA=8                         # inicio de la ventana horaria
# MANTENIMIENTO_HORA_HASTA=20                  # fin de la ventana
# MANTENIMIENTO_RECORDAR_DIAS=7                # recordatorio si no cambió nada
# MANTENIMIENTO_ROLES=dueno,gerencia,jefe_mantenimiento

# ── Resumen periódico del estado de la flota (push a los dueños) ──
# Cada cuántos minutos sale el resumen. 0 lo desactiva. Default 120 (2 horas).
# RESUMEN_FLOTA_MIN=120
# Ventana horaria (hora argentina) para no notificar de madrugada. Default 6 a 22.
# RESUMEN_FLOTA_DESDE=6
# RESUMEN_FLOTA_HASTA=22

# IA (Anthropic). La usan el asistente de flota ("Preguntar" en Control en vivo,
# que consulta la flota con herramientas) y el consultor del panel auditor.
# Opcional: si falta, esos dos responden 503 y el resto de la app funciona igual.
ANTHROPIC_API_KEY=

# Contraseña del usuario admin inicial que crea db/migrate.js.
# Si se deja vacía, el script genera una aleatoria y la imprime UNA vez en consola.
ADMIN_PASSWORD=

# Logs
LOG_LEVEL=warn
# Umbral para el aviso de consulta lenta, en ms (default 1000). Poner 0 muestra
# TODAS las consultas con sus tiempos separados — útil para diagnosticar, muy
# ruidoso para dejar puesto.
# SLOW_QUERY_MS=1000

# ── Pool de conexiones a Postgres ──
# Cuánto vive una conexión inactiva. Por defecto se deriva del intervalo del
# sync del GPS (GPS_SYNC_MINUTES + 1 minuto), porque si las conexiones no
# sobreviven de un sync al siguiente, cada sync paga handshakes nuevos contra la
# base y eso aparece en el log como consultas de un segundo. Solo tocar si sabés
# lo que estás haciendo.
# DB_IDLE_TIMEOUT_MS=180000

# ── Backup automático por email (scripts/backup-email.js / Cron Job de Render) ──
# Estas SOLO hacen falta en el servicio Cron Job de backup, no en la web.
# Destinatario del backup (a dónde te llega el .sql.gz).
BACKUP_EMAIL_TO=tu-email@gmail.com
# SMTP. Para Gmail: SMTP_USER es tu Gmail y SMTP_PASS es una "App Password" de 16
# caracteres (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas
# de aplicaciones). NO es tu contraseña normal de Gmail.
SMTP_USER=tu-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Opcionales (valores por defecto pensados para Gmail):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Límite de adjunto en MB (Gmail corta en ~25). Si el dump supera esto, manda aviso sin adjunto.
BACKUP_MAX_MB=20

# ── Email de Órdenes de Compra al proveedor (reusa SMTP_* de arriba) ──
# Cuando una OC se marca "Enviada al proveedor", se le manda un mail con el PDF
# adjunto al email cargado en la ficha del proveedor. Si el proveedor no tiene
# email, simplemente no se envía (no rompe nada). Opcionales:
# OC_EMAIL_BCC=copia-interna@tuempresa.com   # copia oculta de cada OC enviada
# OC_EMAIL_REPLYTO=compras@tuempresa.com     # a dónde responde el proveedor
